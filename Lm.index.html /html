      </div>
      <div class="p-3 border-t border-[var(--border)] text-center text-[11px] text-slate-400">© 2026 APK SZ Store • Verified Safe</div>
    </div>
  </div>

  <!-- HEADER -->
  <header>
    <div class="header-inner">
      <div class="flex items-center gap-2.5">
        <button class="icon-btn" onclick="openDrawer()"><i class="fa-solid fa-bars text-sm"></i></button>
        <div class="flex items-center gap-2 cursor-pointer" onclick="navGo('home')">
          <img src="https://i.ibb.co.com/svHF8kCY/file-000000001d64820880cdac1e1065928f.png" class="w-8 h-8 rounded-lg object-cover shadow-sm">
          <div class="text-sm font-extrabold text-[var(--text)] tracking-tight">APK SZ <span class="text-blue-600">Store</span></div>
        </div>
      </div>

      <button class="icon-btn" onclick="openSearch()"><i class="fa-solid fa-magnifying-glass text-xs"></i></button>

      <!-- SEARCH OVERLAY -->
      <div class="search-overlay" id="searchOverlay">
        <button class="icon-btn" onclick="closeSearch()"><i class="fa-solid fa-arrow-left text-xs"></i></button>
        <div class="flex-1 flex items-center gap-2 bg-[var(--bg)] border-2 border-blue-600 rounded-xl px-3 h-10 overflow-hidden">
