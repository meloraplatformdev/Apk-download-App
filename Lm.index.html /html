  $('#statPreApps').innerText = APPS.filter(a => a.status === 'Pre-Registration').length;
  $('#statTotalDownloads').innerText = formatCompact(totalDownloads);
  $('#statTotalUsers').innerText = formatCompact(totalVisitors);
}

function formatCompact(num){
  if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
  if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
  return (num||0).toLocaleString();
}

