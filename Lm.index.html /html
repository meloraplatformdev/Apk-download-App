async function triggerDownload(id){
  const a = APPS.find(x=>String(x.id)===String(id));
  if(!a || a.status === 'Pre-Registration') return;

  a.downloads = (parseInt(a.downloads) || 0) + 1;
  try {
    await db.ref('apps/' + a.id + '/downloads').set(a.downloads);
  } catch(e){}
  localStorage.setItem('sz_apps_local', JSON.stringify(APPS));

  toast('Download starting...');
  const dlCountEl = $(`#detailDownloads_${a.id}`);
  if(dlCountEl) dlCountEl.innerText = (a.downloads).toLocaleString();

  if(a.apkUrl){
    const link = document.createElement('a');
    link.href = a.apkUrl;
    link.download = (a.name || a.n || 'app') + '.apk';
    link.target = '_blank';
    document.body.appendChild(link);
    link.click();
    link.remove();
  }
}

