  $('#screenshotsGrid').innerHTML = currentScreenshots.map((s, idx)=>`
    <div class="relative w-12 h-16 rounded-lg overflow-hidden border border-slate-300 flex-shrink-0">
      <img src="${s}" class="w-full h-full object-cover">
      <button type="button" onclick="removeScreenshot(${idx})" class="absolute top-0.5 right-0.5 bg-rose-600 text-white w-3.5 h-3.5 rounded-full text-[8px] flex items-center justify-center">✕</button>
    </div>
  `).join('');
}

async function handleFormSubmit(e){
  e.preventDefault();
  const editId = $('#editAppId').value;
  const appObj = {
    id: editId || 'app_' + Date.now(),
    name: $('#appName').value.trim(),
    package: $('#appPackage').value.trim(),
    developer: $('#appDeveloper').value.trim(),
    category: $('#appCategory').value,
    section: $('#appSection').value,
    version: $('#appVersion').value.trim() || '1.0',
    status: $('#appStatus').value,
    downloads: parseInt($('#appDownloads').value) || 0,
    visitors: Math.floor(Math.random()*1000) + 50,
    mod: $('#appMod').value.trim(),
    size: activeApkMetadata.size || '25 MB',
    rating: 1.0,
    apkUrl: $('#appApkUrl').value.trim(),
    apkName: activeApkMetadata.name || 'release.apk',
    apkSize: activeApkMetadata.size || '25 MB',
    icon: currentIconBase64 || $('#appIconUrl').value.trim() || 'https://i.ibb.co.com/svHF8kCY/file-000000001d64820880cdac1e1065928f.png',
    screenshots: currentScreenshots,
    fullDesc: $('#appFullDesc').value.trim(),
    feat: $('#appFeat').checked ? 1 : 0,
    top: $('#appTop').checked ? 1 : 0,
    editor: $('#appEditor').checked ? 1 : 0
  };

  try{ await db.ref('apps/' + appObj.id).set(appObj); }catch(e){}
  const idx = APPS.findIndex(a=>a.id===appObj.id);
  if(idx>-1) APPS[idx] = appObj; else APPS.unshift(appObj);
  localStorage.setItem('sz_apps_local', JSON.stringify(APPS));

  toast(editId ? 'Application updated successfully!' : 'New app deployed!');
  closeModal();
  updateAdminMetrics();
  renderAdminAppTable();
  renderCurrent();
}

async function deleteApp(id){
  if(!confirm("Are you sure you want to delete this application?")) return;
  try{ await db.ref('apps/' + id).remove(); }catch(e){}
  APPS = APPS.filter(a=>a.id!==id);
  localStorage.setItem('sz_apps_local', JSON.stringify(APPS));
  toast("Application deleted");
  updateAdminMetrics();
  renderAdminAppTable();
  renderCurrent();
}

function viewApp(id){
  const a = APPS.find(x=>x.id===id); if(!a) return;
  const screenshots = a.screenshots && a.screenshots.length ? `
    <div class="mt-3">
      <h5 class="text-xs font-bold text-slate-400 uppercase mb-2">Screenshot Gallery</h5>
      <div class="flex gap-2 overflow-x-auto pb-2 custom-scroll">
        ${a.screenshots.map(s => `<img src="${s}" onclick="openLightbox('${s}')" class="w-20 h-36 object-cover rounded-xl border cursor-pointer hover:opacity-90 transition">`).join('')}
      </div>
    </div>
  ` : '';

  $('#viewContent').innerHTML = `
    <div class="flex items-start gap-4 border-b border-slate-100 pb-4">
      <img src="${a.icon||'https://via.placeholder.com/90'}" class="w-16 h-16 rounded-2xl object-cover border">
      <div>
        <h3 class="text-base font-bold text-slate-900">${a.name||a.n}</h3>
        <p class="text-xs font-mono text-slate-400">${a.package}</p>
        <p class="text-xs text-emerald-600 font-semibold mt-1">${a.developer||a.d} • v${a.version||a.v||'1.0'}</p>
      </div>
    </div>
    <div class="py-4 space-y-3 text-xs text-slate-700">
      <p><b>Status:</b> ${a.status}</p>
      <p><b>Category:</b> ${a.category||a.c}</p>
      <p><b>Package File:</b> ${a.apkName||'release.apk'} (${a.size||'25 MB'})</p>
      <p><b>Description:</b> ${a.fullDesc||a.desc||'No description'}</p>
      ${screenshots}
    </div>
  `;
  $('#viewModal').classList.remove('hidden');
}
function closeViewModal(){ $('#viewModal').classList.add('hidden'); }

function renderAdminBanners(){
  $('#admBannerGrid').innerHTML = SLIDES.map((s, idx)=>`
    <div class="p-4 rounded-2xl border relative overflow-hidden" style="background:${s.g}">
      <span class="text-[9px] font-extrabold uppercase bg-white/20 px-2 py-0.5 rounded-full text-white">${s.tag}</span>
      <h4 class="text-sm font-extrabold text-white mt-1">${s.t}</h4>
      <p class="text-xs text-white/80">${s.p}</p>
      <button onclick="deleteBanner(${idx})" class="absolute top-3 right-3 bg-red-600 text-white p-1 rounded-lg text-xs"><i class="fa-solid fa-trash"></i></button>
    </div>
  `).join('') || '<p class="text-slate-400 text-xs">No banners added</p>';
}
function openBannerModal(){ $('#bannerModal').classList.remove('hidden'); }
async function saveBannerSlide(){
  const slide = {
    id: 's_' + Date.now(),
    tag: $('#b_tag').value.trim() || 'Featured',
    t: $('#b_t').value.trim() || 'New Promo',
    p: $('#b_p').value.trim() || 'Special store release',
    g: $('#b_g').value
  };
  SLIDES.push(slide);
  try{ await db.ref('slides').set(SLIDES); }catch(e){}
  localStorage.setItem('sz_slides_local', JSON.stringify(SLIDES));
  $('#bannerModal').classList.add('hidden');
  renderAdminBanners();
  toast("Banner added");
}
async function deleteBanner(idx){
  SLIDES.splice(idx,1);
  try{ await db.ref('slides').set(SLIDES); }catch(e){}
  localStorage.setItem('sz_slides_local', JSON.stringify(SLIDES));
  renderAdminBanners();
}

function renderAdminCategories(){
  $('#admCategoryChips').innerHTML = CATS.map((c, idx)=>`
    <div class="bg-slate-100 border text-slate-700 px-3 py-1.5 rounded-xl text-xs flex items-center gap-2">
      <span>${c}</span>
      <button onclick="deleteCategory(${idx})" class="text-rose-500 font-bold">✕</button>
    </div>
  `).join('');
}
async function addCategory(){
  const val = $('#newCatInput').value.trim();
  if(!val) return;
  if(!CATS.includes(val)) CATS.push(val);
  $('#newCatInput').value = '';
  try{ await db.ref('categories').set(CATS); }catch(e){}
  localStorage.setItem('sz_cats_local', JSON.stringify(CATS));
  renderAdminCategories();
  toast("Category added");
}
async function deleteCategory(idx){
  CATS.splice(idx, 1);
  try{ await db.ref('categories').set(CATS); }catch(e){}
  localStorage.setItem('sz_cats_local', JSON.stringify(CATS));
  renderAdminCategories();
}

async function saveSocialSettings(){
  SETTINGS.telegram = $('#set_telegram').value.trim();
  SETTINGS.youtube = $('#set_youtube').value.trim();
  SETTINGS.notice = $('#set_notice').value.trim();
  try{ await db.ref('settings').set(SETTINGS); }catch(e){}
  localStorage.setItem('sz_settings_local', JSON.stringify(SETTINGS));
  applySettingsToStore();
  toast("Social settings saved!");
}
async function savePrivacyPolicy(){
  SETTINGS.privacy = $('#set_privacy').value.trim();
  try{ await db.ref('settings').set(SETTINGS); }catch(e){}
  localStorage.setItem('sz_settings_local', JSON.stringify(SETTINGS));
  toast("Privacy Policy updated!");
}
function applySettingsToStore(){
  if(SETTINGS.telegram) $('#drawerTelegramLink').href = SETTINGS.telegram;
  if(SETTINGS.youtube) $('#drawerYoutubeLink').href = SETTINGS.youtube;
  if(SETTINGS.notice) $('#footerStoreNotice').innerText = SETTINGS.notice;
}

function renderCurrent(){
  if(view==='home'){ if(activeCat) filterCat(activeCat); else renderHome(); }
  else navGo(view);
}

function initData(){
  db.ref('apps').on('value', snap => {
    const data = snap.val();
    APPS = data ? Object.values(data) : (JSON.parse(localStorage.getItem('sz_apps_local')) || []);
    renderCurrent();
    checkDeepLink();
  }, () => {
    APPS = JSON.parse(localStorage.getItem('sz_apps_local')) || [];
    renderCurrent();
    checkDeepLink();
  });

  db.ref('slides').on('value', snap => {
    const data = snap.val();
    if(data) SLIDES = Object.values(data);
    if(view==='home') renderHero();
  });

  db.ref('categories').on('value', snap => {
    const data = snap.val();
    if(data) CATS = Object.values(data);
  });

  db.ref('settings').on('value', snap => {
    const data = snap.val();
    if(data){ SETTINGS = data; applySettingsToStore(); }
  });
}

initData();
applySettingsToStore();
renderHome();
</script>
</body>
</html>
