/* SMART DEEP LINK SHARE FUNCTION */
function shareStore(title, appId){
  let shareUrl = window.location.origin + window.location.pathname;
  if(appId){
    shareUrl += '?id=' + encodeURIComponent(appId);
  }
  
  if(navigator.share){
    navigator.share({
      title: title || 'APK SZ Store',
      text: `Download ${title || 'APK'} on APK SZ Store!`,
      url: shareUrl
    }).catch(()=>{
      copyToClip(shareUrl);
    });
  } else {
    copyToClip(shareUrl);
  }
}

function copyToClip(text){
  if(navigator.clipboard && window.isSecureContext){
    navigator.clipboard.writeText(text).then(()=>toast('App link copied to clipboard!')).catch(()=>fallbackCopy(text));
  } else {
    fallbackCopy(text);
  }
}

function fallbackCopy(text){
  const ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed';
  ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.focus();
  ta.select();
  try {
    document.execCommand('copy');
    toast('App link copied to clipboard!');
  } catch(e){
    prompt('Copy this app link:', text);
  }
  ta.remove();
}

function checkDeepLink(){
  const urlParams = new URLSearchParams(window.location.search);
  const requestedId = urlParams.get('id') || urlParams.get('app');
  if(requestedId && APPS.length){
    const app = APPS.find(a => String(a.id) === String(requestedId));
    if(app){
      openDetail(app.id);
    }
  }
}

